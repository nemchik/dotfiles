[user]
  # Email address Git records on commits from this machine.
  email = eric@nemchik.com

  # Author name Git records on commits from this machine.
  name = Eric Nemchik

  # SSH public key Git uses for SSH-based commit and tag signing.
  signingKey = ~/.ssh/id_ed25519.pub

[core]
  # Shared attributes file applied to every repository.
  attributesFile = ~/.gitattributes

  # Default editor for commit messages and other interactive Git prompts.
  editor = code --wait

  # Avoid listing decomposed Unicode filenames as untracked on platforms that normalize names.
  precomposeUnicode = false

  # Cache untracked-file state to speed up status and similar commands.
  untrackedCache = true

  # Treat indentation and trailing-whitespace problems as errors.
  whitespace = space-before-tab,-indent-with-non-tab,trailing-space

  # Prefer filesystem timestamps that behave more safely across filesystem boundaries.
  trustctime = false

  # Preload index entries to make operations on large trees faster.
  preloadIndex = true

  # Enable filesystem caching for Git on Windows.
  fscache = true

  # Use filesystem monitoring to avoid re-scanning unchanged paths.
  fsmonitor = true

  # Store and use commit-graph data for faster history and reachability queries.
  commitGraph = true

[feature]
  # Opt into Git's optimizations for very large repositories.
  manyFiles = true

[column]
  # Format columnar output automatically when Git uses this renderer.
  ui = auto

[gpg]
  # Sign commits and tags with SSH keys instead of OpenPGP keys.
  format = ssh

[diff]
  # Use VS Code for graphical diff and merge tools.
  guitool = vscode

  # Use VS Code for text-based diff operations.
  tool = vscode

  # Spend more time finding better diff matches for cleaner output.
  algorithm = histogram

  # Allow Git to search a wider range when detecting renamed files.
  renameLimit = 9999

  # Render diff output with automatic colors.
  color = auto

  # Detect renames and copies when comparing changes.
  renames = copies

[merge]
  # Use VS Code for graphical merge operations.
  guitool = vscode

  # Use VS Code for text-based merge operations.
  tool = vscode

  # Show a summary of file-level changes after merges.
  stat = true

  # Show both sides of a conflict plus the common ancestor for easier resolution.
  conflictStyle = zdiff3

  # Include summaries of merged commits in generated merge commit messages.
  log = true

[rerere]
  # Reuse recorded conflict resolutions when the same conflict appears again.
  enabled = true

  # Automatically stage reused conflict resolutions.
  autoUpdate = true

[apply]
  # Warn when patch application would introduce whitespace problems.
  whitespace = warn

  # Automatically fix whitespace errors when patching.
  #whitespace = fix

[commit]
  # Sign commits by default.
  gpgSign = true

[fetch]
  # Update the commit-graph after fetching.
  writeCommitGraph = true

  # Remove remote-tracking refs that no longer exist on the remote.
  prune = true

[push]
  # Sign pushes when the remote asks for it.
  gpgSign = if-asked

  # Push matching annotated tags alongside branch pushes.
  followTags = true

  # Default to simple push behavior for the current branch.
  default = simple

[pull]
  # Rebase instead of merge when pulling changes.
  rebase = true

[rebase]
  # Automatically reorder fixup and squash commits during interactive rebases.
  autoSquash = true

  # Stash local changes automatically before a rebase and restore them afterward.
  autoStash = true

  # Warn when commits would be dropped during a rebase.
  missingCommitsCheck = warn

[tag]
  # Sign tags by default.
  gpgSign = true

[includeIf "gitdir:/workspaces/"]
  # Load additional settings for Codespaces and other /workspaces checkouts.
  path = .gitconfig-codespaces

[maintenance]
